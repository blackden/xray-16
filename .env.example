# Copy to .env to override Makefile defaults. .env is gitignored.
# Loaded by Makefile via `-include .env`. All variables are optional —
# the Makefile has working defaults.
#
# Syntax:
#   * `KEY = value` or `KEY=value` (this is a Makefile fragment).
#   * Do NOT quote values. `STEAM_LOGIN = "foo"` becomes literally `"foo"`.
#   * `#` starts a comment.

# --- Build -----------------------------------------------------------------
# BUILD_DIR   = build
# BUILD_TYPE  = Mixed                 # Debug | Mixed | Release | ReleaseMasterGold
# PARALLEL    = 4                     # cmake --build --parallel N. Lower to 2 on 8 GB RAM.

# --- Game data -------------------------------------------------------------
# GAME_DIR    = /Users/you/Games/STALKER-CoP
# FSGAME_LTX  = /Users/you/Games/STALKER-CoP/fsgame.ltx   # defaults to $(GAME_DIR)/fsgame.ltx

# --- Steam (only needed for `make install-game`) ---------------------------
# STEAM_LOGIN = your_steam_login
# APPID       = 41700                 # 41700 = Call of Pripyat, 20510 = Clear Sky

# --- Runtime ---------------------------------------------------------------
# EXTRA_ARGS  = -nointro              # xr_3da flags. e.g. -cs, -soc, -nogame
