# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode
!.env.example

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/

# clangd LSP — compile_commands.json symlink at repo root,
# .cache/ index dir. Both live alongside build-lsp/.
compile_commands.json
.cache/

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*

# per-run macOS session artifacts created by `make run`
notes/session-*/

# packaged .app bundle output from `make package`
/dist/
build-profile/
build-tests/
notes/tracy/

# Unpacked vanilla CoP archives from `make unpack-cop` (xrUnpack output).
# Reference tree for modding workflow; not source we ship.
_workspace/
