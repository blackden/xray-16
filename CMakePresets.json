{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS ARM64 Debug",
      "description": "Configure OpenXRay for Debug on macOS ARM64 using Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-relwithdebinfo",
      "displayName": "macOS ARM64 RelWithDebInfo",
      "description": "Configure OpenXRay for RelWithDebInfo on macOS ARM64 using Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS ARM64 Release",
      "description": "Configure OpenXRay for Release on macOS ARM64 using Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-debug-build",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-relwithdebinfo-build",
      "configurePreset": "macos-arm64-relwithdebinfo"
    },
    {
      "name": "macos-arm64-release-build",
      "configurePreset": "macos-arm64-release"
    }
  ]
}
